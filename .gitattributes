# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit shell script normalization
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Source, documentation, and structured data
*.ts text
*.tsx text
*.js text
*.css text
*.html text
*.md text diff=markdown
*.json text
*.yml text
*.yaml text
*.svg text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary
*.pdf binary

# Release archive exclusions
.github export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
.markdownlint.json export-ignore
